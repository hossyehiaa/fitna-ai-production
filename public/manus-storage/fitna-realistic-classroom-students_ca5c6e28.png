<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <rect width="1200" height="800" fill="#0A0D14"/>
  <rect x="50" y="50" width="1100" height="700" rx="16" fill="#071B3A" stroke="#12B8C4" stroke-width="2"/>
  
  <!-- Omar -->
  <g transform="translate(150, 200)">
    <circle cx="100" cy="100" r="70" fill="#12B8C4" opacity="0.8"/>
    <text x="100" y="110" font-family="sans-serif" font-size="32" font-weight="bold" fill="#FFF" text-anchor="middle">Omar / عمر</text>
    <text x="100" y="145" font-family="sans-serif" font-size="20" fill="#FFB800" text-anchor="middle">Distracted / مشتت</text>
  </g>
  
  <!-- Sara -->
  <g transform="translate(420, 200)">
    <circle cx="100" cy="100" r="70" fill="#FFB800" opacity="0.8"/>
    <text x="100" y="110" font-family="sans-serif" font-size="32" font-weight="bold" fill="#FFF" text-anchor="middle">Sara / سارة</text>
    <text x="100" y="145" font-family="sans-serif" font-size="20" fill="#00F0FF" text-anchor="middle">Hand Raised / متفوقة</text>
  </g>

  <!-- Yassin -->
  <g transform="translate(690, 200)">
    <circle cx="100" cy="100" r="70" fill="#D96B58" opacity="0.8"/>
    <text x="100" y="110" font-family="sans-serif" font-size="32" font-weight="bold" fill="#FFF" text-anchor="middle">Yassin / ياسين</text>
    <text x="100" y="145" font-family="sans-serif" font-size="20" fill="#FFF" text-anchor="middle">Confused / خجول</text>
  </g>

  <!-- Nour -->
  <g transform="translate(950, 200)">
    <circle cx="100" cy="100" r="70" fill="#7BD79F" opacity="0.8"/>
    <text x="100" y="110" font-family="sans-serif" font-size="32" font-weight="bold" fill="#FFF" text-anchor="middle">Nour / نور</text>
    <text x="100" y="145" font-family="sans-serif" font-size="20" fill="#00F0FF" text-anchor="middle">Engaged / مشارك ذكي</text>
  </g>
</svg>
