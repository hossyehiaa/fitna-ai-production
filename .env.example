# ============================================
# Fitna AI — Environment variables (production backend)
# Copy this file to .env / .env.local and fill in real values.
# NEVER commit .env, .env.local or any file with real keys.
# ============================================

# Postgres (Neon) — production database
DATABASE_URL=

# Session token HMAC secret (32+ random chars). Generates cookie signatures.
AUTH_SECRET=

# OpenRouter (openrouter.ai) — PAID-TIER LLM layer:
# roleplay = anthropic/claude-sonnet-4.5 (+ gemini-2.5-pro/flash fallbacks)
# report   = anthropic/claude-opus-4.5
# classify = anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
# Optional model pins
# OPENROUTER_ROLEPLAY_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_REPORT_MODEL=anthropic/claude-opus-4.5
# OPENROUTER_CLASSIFIER_MODEL=anthropic/claude-haiku-4.5

# Groq (console.groq.com) — Whisper STT only (LLM moved to OpenRouter)
GROQ_API_KEY=

# Fish Audio — TTS #1 (dialect-cloned voices, product core)
FISH_AUDIO_API_KEY=
# Free model; requests default to this. Override only if the account has credit.
# FISH_AUDIO_MODEL=s2.1-pro-free

# ElevenLabs — TTS #2 (emotional realism, eleven_v3). Empty = skipped.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB

# Gemini — teacher tone analysis (2.5-pro) + TTS #3. Empty = skipped.
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE_FEMALE=Leda
# GEMINI_TTS_VOICE_MALE=Puck

# Force Edge-only TTS (skip Fish/ElevenLabs/Gemini): set to "msedge"
# TTS_PROVIDER=msedge

# Public URL of this app (used in share/reset links + OpenRouter referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000
