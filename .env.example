# ============================================
# Fitna AI — Environment variables (production backend)
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file with real keys.
# ============================================

# Postgres (Neon) — production database
DATABASE_URL=

# Session token HMAC secret (32+ random chars). Generates cookie signatures.
AUTH_SECRET=

# Groq (console.groq.com) — gpt-oss-120b student agents + Whisper STT
GROQ_API_KEY=
# Optional override for the chat model chain head
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Fish Audio — primary TTS provider (server-side only)
FISH_AUDIO_API_KEY=
# Free model; requests default to this. Override only if the account has credit.
# FISH_AUDIO_MODEL=s2.1-pro-free

# Force Edge-only TTS (skip Fish Audio): set to "msedge"
# TTS_PROVIDER=msedge

# Public URL of this app (used in share/reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
