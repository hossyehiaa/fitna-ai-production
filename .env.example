# =====================================================================
# Fitna AI — Environment variables template
#
# Copy to .env.local for development:  cp .env.example .env.local
# In production, configure these in Vercel → Settings → Environment Variables.
#
# SECURITY RULES:
#   * NEVER commit real values. .env* files are gitignored.
#   * Only NEXT_PUBLIC_* variables may ever reach the browser bundle.
#   * Database/auth/AI secrets are read server-side ONLY.
#   * If a secret leaks (chat, logs, screenshots), rotate it immediately.
# =====================================================================

# ── Database (REQUIRED) ─────────────────────────────────────────────
# Neon PostgreSQL connection string.
# Create: https://console.neon.tech → Project → Connection string (pooled).
# Never expose to the browser. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth (REQUIRED) ─────────────────────────────────────────────────
# Session token HMAC pepper. Generate: openssl rand -hex 32
AUTH_SECRET=""

# ── AI provider (OPTIONAL — graceful fallback without it) ───────────
# Groq: student-agent reactions + Whisper STT (Arabic dialects).
# Create: https://console.groq.com → API Keys.
# When missing, the deterministic classroom engine takes over (fully functional)
# and STT returns a clean Arabic message; the UI offers text input instead.
GROQ_API_KEY=""

# ── Speech providers ────────────────────────────────────────────────
# TTS chain: fish-audio (primary when FISH_AUDIO_API_KEY is set) →
# Microsoft Edge neural voices (always-on fallback: free, no key,
# native ar-SA + ar-EG voices). TTS_PROVIDER="msedge" forces Edge only.
# Fish Audio key: https://fish.audio → Developers. Note: Fish Audio API
# credit is billed separately from platform credit — without API credit
# the chain transparently serves Edge voices and sessions stay alive.
FISH_AUDIO_API_KEY=""
TTS_PROVIDER="fish"
STT_PROVIDER="groq"

# ── Email for password reset (OPTIONAL) ─────────────────────────────
# Resend: transactional email for password-reset links.
# Create: https://resend.com → API Keys. Without it, password reset via email
# is disabled (in dev the reset link is returned to the requesting flow only).
RESEND_API_KEY=""
EMAIL_FROM="Fitna AI <onboarding@resend.dev>"

# ── App URL (REQUIRED in production) ────────────────────────────────
# Canonical public origin — used in email links and CSRF origin checks.
# In Vercel: https://<your-deployment>.vercel.app or your custom domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Deployment tokens (ONLY for CI/CLI automation, never in app code) ─
# GITHUB_TOKEN=""
# VERCEL_TOKEN=""
