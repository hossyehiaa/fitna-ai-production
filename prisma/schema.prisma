// =====================================================================
// Fitna AI — production database schema.
//
// The table/column names mirror the ORIGINAL Fitna AI Supabase schema
// (supabase/schema.sql from mariamhisham24/Fitna-ai) EXACTLY, so the
// original frontend's data-access expectations are preserved 1:1.
//
// Production backend additions (invisible to the UI):
//   * users.password_hash          — scrypt hash (custom auth, no Supabase Auth)
//   * student_personas.is_active   — soft toggle used by session setup
//   * student_personas.dialect     — 'egyptian_arabic' | 'saudi_arabic'
//   * sessions.dialect             — classroom dialect selected at setup
//   * auth_sessions                — opaque server sessions (HttpOnly cookie)
//   * password_reset_tokens        — recovery tokens for /auth/confirm flow
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users   User[]
  cohorts Cohort[]
  lessonTopics LessonTopic[]

  @@map("institutions")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      String // 'teacher' | 'institution_admin' | 'super_admin'
  institutionId String? @map("institution_id") @db.Uuid
  preferredLanguage String @default("ar") @map("preferred_language")
  preferredTheme    String @default("light") @map("preferred_theme")
  teachingExperience String? @map("teaching_experience")
  teachingLevel      String? @map("teaching_level")
  subject            String?
  trainingGoals      String[] @default([]) @map("training_goals")
  // Production auth: scrypt$N$r$p$saltB64$hashB64 (Supabase Auth replacement)
  passwordHash String? @map("password_hash")
  // Account creation: explicit user selection (never inferred from locale/IP)
  country       String? // 'EG' | 'SA'
  accountType   String? @map("account_type") // 'individual' | 'organization' | 'teacher'
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  institution       Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  sessions          Session[]
  badges            Badge[]
  authSessions      AuthSession[]
  passwordResetToken PasswordResetToken[]
  lessonTopicsCreated LessonTopic[] @relation("LessonTopicCreator")
  cohortMemberships  CohortMember[]

  @@index([institutionId])
  @@map("users")
}

model LessonTopic {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr       String   @map("title_ar")
  titleEn       String?  @map("title_en")
  institutionId String?  @map("institution_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  creator     User?        @relation("LessonTopicCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sessions    Session[]

  @@map("lesson_topics")
}

model StudentPersona {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  age               Int
  dialect           String   @default("egyptian_arabic")
  personalityPrompt String   @map("personality_prompt")
  baseAttention     Int      @default(70) @map("base_attention")
  strengths         String[] @default([])
  weaknesses        String[] @default([])
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Character Identity System (production fix): stable key + gender +
  // nationality + avatar + per-character voice configuration. Deterministic
  // and persisted — never regenerated per session.
  characterKey      String?  @unique @map("character_key")
  gender            String   @default("male")
  nationality       String   @default("EG")
  avatarKey         String?  @map("avatar_key")
  voiceProvider     String   @default("fish") @map("voice_provider")
  voiceId           String?  @map("voice_id")
  edgeVoice         String?  @map("edge_voice")
  personality       String?
  speakingStyle     String?  @map("speaking_style")
  ageRange          String?  @map("age_range")

  sessionStudents SessionStudent[]

  @@map("student_personas")
}

model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String   @map("teacher_id") @db.Uuid
  institutionId        String?  @map("institution_id") @db.Uuid
  topicId              String?  @map("topic_id") @db.Uuid
  lessonContext        String?  @map("lesson_context")
  durationMinutes      Int      @default(15) @map("duration_minutes")
  classroomStyle       String?  @map("classroom_style")
  trainingObjective    String?  @map("training_objective")
  status               String   @default("in_progress")
  startedAt            DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(3)
  overallScore         Decimal? @map("overall_score") @db.Decimal(5, 2)
  teacherTalkRatio     Decimal? @map("teacher_talk_ratio") @db.Decimal(5, 2)
  socraticQuestionRate Decimal? @map("socratic_question_rate") @db.Decimal(5, 2)
  inclusivityIndex     Decimal? @map("inclusivity_index") @db.Decimal(5, 2)
  classroomPattern     String?  @map("classroom_pattern")
  dialect              String   @default("egyptian_arabic")

  teacher         User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topic           LessonTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sessionStudents SessionStudent[]
  sessionEvents   SessionEvent[]
  report          Report?
  badges          Badge[]

  @@index([teacherId])
  @@index([institutionId])
  @@map("sessions")
}

model SessionStudent {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String  @map("session_id") @db.Uuid
  personaId      String  @map("persona_id") @db.Uuid
  finalAttention Int?    @map("final_attention")
  timesSpoken    Int     @default(0) @map("times_spoken")

  session Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  persona StudentPersona @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@map("session_students")
}

model SessionEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  eventType    String   @map("event_type")
  actor        String
  content      String
  audioUrl     String?  @map("audio_url")
  metadata     Json?
  occurredAtMs Int      @map("occurred_at_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAtMs])
  @@map("session_events")
}

model Report {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String   @unique @map("session_id") @db.Uuid
  summaryAr       String   @map("summary_ar")
  sessionSignalAr String   @map("session_signal_ar")
  strengths       String[] @default([])
  weaknesses      String[] @default([])
  recommendations String[] @default([])
  evidenceMoments Json     @default("[]") @map("evidence_moments")
  frameworkScores Json?    @map("framework_scores")
  shareToken      String   @default(dbgenerated("gen_random_uuid()")) @map("share_token") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Badge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  badgeKey   String   @map("badge_key")
  unlockedAt DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  sessionId  String?  @map("session_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeKey])
  @@map("badges")
}

model Cohort {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  members     CohortMember[]

  @@index([institutionId])
  @@map("cohorts")
}

model CohortMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId  String   @map("cohort_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([cohortId, teacherId])
  @@index([cohortId])
  @@map("cohort_members")
}

// ---------------------------------------------------------------------
// Production auth tables (replaces Supabase Auth / auth.users)
// ---------------------------------------------------------------------

model AuthSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
